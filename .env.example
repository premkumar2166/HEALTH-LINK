# ==============================================================================
# HEALTHLINK - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SECRETS TO VERSION CONTROL!
# Copy this file to .env.local for local development.
# Copy this file to .env.production for production environment on the server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure 64-character hex string for production: `openssl rand -hex 32`
JWT_SECRET=super-secret-key-for-healthlink-that-is-at-least-32-chars-long

# ------------------------------------------------------------------------------
# 3. DATABASE (Prisma)
# ------------------------------------------------------------------------------
# Dev default uses SQLite. For production, switch provider to postgresql in schema.prisma.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION (File Uploads, Images, Documents)
# ------------------------------------------------------------------------------
# CONFIGURATION REQUIRED
STORAGE_PROVIDER=CONFIGURATION_REQUIRED
S3_BUCKET_NAME=CONFIGURATION_REQUIRED
S3_ACCESS_KEY=CONFIGURATION_REQUIRED
S3_SECRET_KEY=CONFIGURATION_REQUIRED
S3_REGION=CONFIGURATION_REQUIRED

# ------------------------------------------------------------------------------
# 5. EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# CONFIGURATION REQUIRED
SMTP_HOST=CONFIGURATION_REQUIRED
SMTP_PORT=CONFIGURATION_REQUIRED
SMTP_USER=CONFIGURATION_REQUIRED
SMTP_PASS=CONFIGURATION_REQUIRED
EMAIL_FROM="noreply@healthlink.com"

# ------------------------------------------------------------------------------
# 6. REALTIME CONFIGURATION (WebSockets / Push Notifications)
# ------------------------------------------------------------------------------
# CONFIGURATION REQUIRED
NEXT_PUBLIC_REALTIME_ENDPOINT=CONFIGURATION_REQUIRED
REALTIME_SECRET_KEY=CONFIGURATION_REQUIRED

# ------------------------------------------------------------------------------
# 7. AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# CONFIGURATION REQUIRED
OPENAI_API_KEY=CONFIGURATION_REQUIRED
ANTHROPIC_API_KEY=CONFIGURATION_REQUIRED
AI_MODEL_PREFERENCE="gpt-4"

# ------------------------------------------------------------------------------
# 8. CORS & ALLOWED ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,https://healthlink-app.com"
